# -------------- runtime configuration
timestamp=2025-11-19T11:59:29+0000
dry_run=false
only_benchmark_test=false
force_remove=true
container_runtime=nerdctl
vllm_image=docker.hlmirror.com/lmcache/vllm-openai:v0.3.9
